# Database (Neon PostgreSQL - https://neon.tech)
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Google Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSy..."
# Available models: gemini-1.5-pro, gemini-1.5-flash, gemini-1.0-pro
GEMINI_MODEL="gemini-1.5-pro"

# WhatsApp Business API (Meta Cloud API)
# Get from: https://developers.facebook.com/apps/
WA_ACCESS_TOKEN="EAAxxxxxxx"
WA_PHONE_NUMBER_ID="1234567890"
WA_VERIFY_TOKEN="your-custom-random-string"

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
# NEXTAUTH_URL is optional - will auto-detect from request
# Set this in production to prevent open redirect attacks:
# NEXTAUTH_URL="https://your-domain.com"
